<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CentralTickets.Api\CentralTickets.Api.csproj" />
    <ProjectReference Include="..\CentralTickets.Hook\CentralTickets.Hook.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CentralTickets.UsageCollector\CentralTickets.UsageCollector.csproj" />
    <None Include="..\CentralTickets.Plugin\.claude-plugin\plugin.json" Link="plugin\.claude-plugin\plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CentralTickets.Plugin\hooks\hooks.json" Link="plugin\hooks\hooks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="CopyHookRuntimeForIntegrationTests" AfterTargets="Build">
    <ItemGroup>
      <HookRuntimeFiles Include="$(MSBuildThisFileDirectory)..\CentralTickets.Hook\bin\$(Configuration)\net10.0\*" />
      <SessionRunnerRuntimeFiles Include="$(MSBuildThisFileDirectory)..\CentralTickets.SessionRunner\bin\$(Configuration)\net10.0\CentralTickets.SessionRunner.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(HookRuntimeFiles);@(SessionRunnerRuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
